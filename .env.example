# Copy to .env and fill in real values. .env is gitignored; never commit it.
#
# Generate a SECRET_KEY with:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=

# 'True' enables Django's debug pages. Anything else is False.
# Never True outside local development: the debug page leaks source, settings,
# the database backend, and on a 404 dumps the entire URL configuration.
DEBUG=False

# Comma-separated. Required once DEBUG is False.
ALLOWED_HOSTS=127.0.0.1,localhost

# Must match compose.yaml, which reads these same variables.
POSTGRES_DB=my_database
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
